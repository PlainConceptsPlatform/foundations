{
  "name": "platform-foundations",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Platform foundation for PlainConcepts Platform apps: theme, conventions, docs, and a themed component showcase.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "pnpm --filter @plainconceptsplatform/ui-components build",
    "dev": "pnpm --filter @plainconceptsplatform/docs dev",
    "build": "pnpm -r build",
    "lint": "pnpm lint:code && pnpm lint:md",
    "lint:code": "biome check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:fix": "pnpm lint:code:fix && pnpm lint:md:fix",
    "lint:code:fix": "biome check --write .",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm build",
    "release:theme": "pnpm --filter @plainconceptsplatform/ui-components build && pnpm typecheck && pnpm --filter @plainconceptsplatform/ui-theme publish --access public",
    "release:components": "pnpm --filter @plainconceptsplatform/ui-components build && pnpm typecheck && pnpm --filter @plainconceptsplatform/ui-components publish --access public",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,js,json,jsx,mjs,ts,tsx}": "biome check --write --no-errors-on-unmatched",
    "*.md": "markdownlint-cli2 --no-globs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@plainconceptsplatform/workflows": "1.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "markdownlint-cli2": "0.23.2",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.17",
      "image-size": "^2.0.3",
      "js-yaml@4": "^4.3.2",
      "js-yaml@5": "^5.4.1",
      "katex": "^0.18.2",
      "markdown-it": "^14.3.3",
      "nanoid@3": "^3.3.18",
      "postcss": "^8.5.23",
      "postcss-selector-parser@7": "^7.1.6",
      "sharp": "^0.35.5",
      "smol-toml": "^1.9.0",
      "source-map-js": "^1.2.2",
      "zod@4": "^4.6.6"
    }
  }
}
